---
interface Props { title: string; description?: string; }
const { title, description = 'Perfil profesional de Arturo Ramirez, ingeniero en sistemas y abogado.' } = Astro.props;
const pathname = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Inicio' },
	{ href: '/portfolio/', label: 'Portafolio' }, { href: '/contacto/', label: 'Contacto' },
];
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} /><meta name="theme-color" content="#173f38" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" /><meta name="generator" content={Astro.generator} /><title>{title}</title>
	</head>
	<body>
		<header class="main-header"><nav class="container navigation" aria-label="Navegación principal">
			<a href="/" class="logo" aria-label="Arturo Ramirez, inicio"><span class="logo-mark">AR</span><span>Arturo Ramirez</span></a>
			<ul class="nav-links">{links.map((link) => <li><a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a></li>)}</ul>
		</nav></header>
		<main><slot /></main>
		<footer><div class="container footer-content"><p>© {new Date().getFullYear()} Arturo Ramirez</p><p>Ingeniería · Software · Derecho</p></div></footer>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@500;600;700&display=swap');
	:root { --ink:#16211f; --muted:#64706d; --paper:#f5f3ed; --surface:#fbfaf6; --line:#d9ddd7; --accent:#b56b45; --accent-dark:#88492e; --forest:#173f38; --white:#fff; --radius:1.25rem; }
	* { box-sizing:border-box; }
	html { scroll-behavior:smooth; }
	body { margin:0; min-height:100vh; display:flex; flex-direction:column; font-family:'DM Sans',system-ui,sans-serif; color:var(--ink); background:linear-gradient(rgba(22,33,31,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(22,33,31,.035) 1px,transparent 1px),var(--paper); background-size:42px 42px; line-height:1.65; }
	a { color:inherit; }
	.container { width:min(1120px,calc(100% - 2.5rem)); margin-inline:auto; }
	.main-header { position:relative; z-index:10; border-bottom:1px solid rgba(22,33,31,.12); background:rgba(245,243,237,.94); }
	.navigation { min-height:82px; display:flex; align-items:center; justify-content:space-between; gap:2rem; }
	.logo { display:inline-flex; align-items:center; gap:.8rem; font-family:'Manrope',sans-serif; font-weight:700; text-decoration:none; letter-spacing:-.02em; }
	.logo-mark { display:grid; place-items:center; width:38px; aspect-ratio:1; border-radius:50%; background:var(--forest); color:var(--surface); font-size:.72rem; letter-spacing:.08em; }
	.nav-links { display:flex; align-items:center; gap:.35rem; padding:0; margin:0; list-style:none; }
	.nav-links a { display:block; padding:.55rem .8rem; border-radius:999px; color:var(--muted); font-size:.92rem; font-weight:600; text-decoration:none; }
	.nav-links a:hover,.nav-links a[aria-current='page'] { background:rgba(23,63,56,.09); color:var(--forest); }
	main { flex:1; }
	footer { border-top:1px solid rgba(22,33,31,.12); color:var(--muted); font-size:.86rem; }
	.footer-content { min-height:90px; display:flex; align-items:center; justify-content:space-between; gap:1rem; }
	.footer-content p { margin:0; }
	@media (max-width:720px) { .navigation { padding-block:1rem; align-items:flex-start; flex-direction:column; gap:.8rem; } .nav-links { width:100%; overflow-x:auto; padding-bottom:.2rem; } .nav-links a { white-space:nowrap; } .footer-content { padding-block:1.5rem; align-items:flex-start; flex-direction:column; justify-content:center; gap:.2rem; } }
</style>
