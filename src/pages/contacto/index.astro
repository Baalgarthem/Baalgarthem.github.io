---
import Layout from '../../layouts/Layout.astro';
const email = 'demonoid@outlook.jp';
const phone = '866 334 8743';
const waLink = 'https://wa.me/528663348743';
const tgLink = 'https://t.me/+528663348743';
const github = 'https://github.com/Baalgarthem';
const linkedin = '#'; // Pendiente de actualizar
---
<Layout title="Contacto — Arturo Ramirez" description="Contacta con Arturo Ramirez. Redes, correo y teléfono.">
	<section class="contact container">
		<header>
			<p class="eyebrow">Contacto directo</p>
			<h1>Conversemos.</h1>
			<p class="lead">Si tienes un proyecto, una consulta o una idea que quieras desarrollar, puedes escribirme directamente por cualquiera de estos medios.</p>
		</header>
		<div class="contact-grid">
			<article class="contact-card">
				<span class="index">01</span>
				<div><p class="label">Correo electrónico</p><a href={`mailto:${email}`}>{email}</a></div>
				<a class="arrow" href={`mailto:${email}`} aria-label="Enviar correo electrónico">↗</a>
			</article>
			<article class="contact-card">
				<span class="index">02</span>
				<div><p class="label">WhatsApp</p><a href={waLink} target="_blank" rel="noopener noreferrer">{phone}</a></div>
				<a class="arrow" href={waLink} target="_blank" rel="noopener noreferrer" aria-label="Abrir WhatsApp">↗</a>
			</article>
			<article class="contact-card">
				<span class="index">03</span>
				<div><p class="label">Telegram</p><a href={tgLink} target="_blank" rel="noopener noreferrer">{phone}</a></div>
				<a class="arrow" href={tgLink} target="_blank" rel="noopener noreferrer" aria-label="Abrir Telegram">↗</a>
			</article>
			<article class="contact-card">
				<span class="index">04</span>
				<div><p class="label">GitHub</p><a href={github} target="_blank" rel="noopener noreferrer">Baalgarthem</a></div>
				<a class="arrow" href={github} target="_blank" rel="noopener noreferrer" aria-label="Abrir GitHub">↗</a>
			</article>
			<article class="contact-card">
				<span class="index">05</span>
				<div><p class="label">LinkedIn</p><a href={linkedin} target="_blank" rel="noopener noreferrer">Perfil Profesional</a></div>
				<a class="arrow" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="Abrir LinkedIn">↗</a>
			</article>
		</div>
	</section>
</Layout>
<style>
	.contact { padding-block:clamp(4rem,10vw,7.5rem); min-height: 80vh; }
	.contact header { display:grid; grid-template-columns:1fr 1fr; column-gap:4rem; align-items:end; padding-bottom:3.5rem; }
	.eyebrow { grid-column:1/-1; margin:0 0 1.25rem; color:var(--accent); font-size:.76rem; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
	h1 { margin:0; font-family:'Manrope',sans-serif; font-size:clamp(3.5rem,8vw,7rem); letter-spacing:-.07em; line-height:.9; }
	.lead { max-width:520px; margin:0; color:var(--muted); font-size:1.1rem; }
	.contact-grid { border-top:1px solid var(--line); }
	.contact-card { display:grid; grid-template-columns:80px 1fr auto; align-items:center; gap:1rem; min-height:120px; border-bottom:1px solid var(--line); transition:background 0.3s; }
	.contact-card:hover { background: rgba(23,63,56,.02); }
	.index { color:var(--accent); font-family:Georgia,serif; font-size:1.3rem; padding-left: 1rem; }
	.label { margin:0 0 .25rem; color:var(--muted); font-size:.76rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
	.contact-card a:not(.arrow) { margin:0; color:var(--ink); font-family:'Manrope',sans-serif; font-size:clamp(1.1rem,2.5vw,1.6rem); font-weight:600; text-decoration:none; }
	.contact-card a:not(.arrow):hover { color: var(--forest); text-decoration: underline; text-underline-offset: 4px; }
	.arrow { display:grid; place-items:center; width:48px; height:48px; border:1px solid var(--line); border-radius:50%; color:var(--forest); font-size:1.2rem; text-decoration:none; transition:background 0.3s, color 0.3s; margin-right: 1rem; }
	.contact-card:hover .arrow { background: var(--forest); color: var(--white); border-color: var(--forest); }
	
	@media (max-width:720px) { 
		.contact header { grid-template-columns:1fr; gap:1.5rem; } 
		.contact-card { grid-template-columns:45px 1fr auto; min-height: 100px; } 
		.index { padding-left: 0; }
		.contact-card a:not(.arrow) { font-size:1rem; overflow-wrap:anywhere; } 
	}
</style>
