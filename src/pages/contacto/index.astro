---
import Layout from '../../layouts/Layout.astro';
const email = 'demonoid@outlook.jp';
const whatsapp = '';
---
<Layout title="Contacto — Arturo Ramirez" description="Correo electrónico y WhatsApp de Arturo Ramirez.">
	<section class="contact container">
		<header><p class="eyebrow">Contacto directo</p><h1>Conversemos.</h1><p class="lead">Si tienes un proyecto, una consulta o una idea que quieras desarrollar, puedes escribirme directamente por cualquiera de estos medios.</p></header>
		<div class="contact-grid">
			<article class="contact-card"><span class="index">01</span><div><p class="label">Correo electrónico</p><a href={`mailto:${email}`}>{email}</a></div><a class="arrow" href={`mailto:${email}`} aria-label="Enviar correo electrónico">↗</a></article>
			<article class="contact-card muted"><span class="index">02</span><div><p class="label">WhatsApp</p>{whatsapp ? <a href={`https://wa.me/${whatsapp}`}>Iniciar conversación</a> : <p class="pending">Número por añadir</p>}</div><span class="arrow" aria-hidden="true">—</span></article>
		</div>
	</section>
</Layout>
<style>
	.contact { padding-block:clamp(4rem,10vw,7.5rem); }
	.contact header { display:grid; grid-template-columns:1fr 1fr; column-gap:4rem; align-items:end; padding-bottom:3.5rem; }
	.eyebrow { grid-column:1/-1; margin:0 0 1.25rem; color:var(--accent); font-size:.76rem; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
	h1 { margin:0; font-family:'Manrope',sans-serif; font-size:clamp(3.5rem,8vw,7rem); letter-spacing:-.07em; line-height:.9; }
	.lead { max-width:520px; margin:0; color:var(--muted); font-size:1.1rem; }
	.contact-grid { border-top:1px solid var(--line); }
	.contact-card { display:grid; grid-template-columns:80px 1fr auto; align-items:center; gap:1rem; min-height:150px; border-bottom:1px solid var(--line); }
	.index { color:var(--accent); font-family:Georgia,serif; font-size:1.3rem; }
	.label { margin:0 0 .25rem; color:var(--muted); font-size:.76rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
	.contact-card a:not(.arrow),.pending { margin:0; color:var(--ink); font-family:'Manrope',sans-serif; font-size:clamp(1.25rem,3vw,2rem); font-weight:600; text-decoration-thickness:1px; text-underline-offset:.35rem; }
	.arrow { display:grid; place-items:center; width:48px; height:48px; border:1px solid var(--line); border-radius:50%; color:var(--forest); font-size:1.2rem; text-decoration:none; }
	.muted { opacity:.7; }
	@media (max-width:720px) { .contact header { grid-template-columns:1fr; gap:1.5rem; } .contact-card { grid-template-columns:45px 1fr auto; } .contact-card a:not(.arrow),.pending { font-size:1rem; overflow-wrap:anywhere; } }
</style>
