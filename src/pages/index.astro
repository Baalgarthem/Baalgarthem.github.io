---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Arturo Ramirez — Ingeniería, software y derecho" description="Presentación profesional de Arturo Ramirez, ingeniero en sistemas y abogado.">
	<section class="hero container">
		<div class="hero-copy animate-on-scroll">
			<p class="eyebrow"><span></span> Ingeniero en sistemas · Formación Legal</p>
			
			<div class="hero-title-row">
				<h1>Arturo<br /><em>Ramirez.</em></h1>
				<div class="hero-contact-card">
					<div class="actions">
						<a href="/contacto/" class="primary-button">Hablemos <span aria-hidden="true">↗</span></a>
						<a href="/portfolio/" class="text-link">Ver trabajo <span aria-hidden="true">→</span></a>
					</div>
					<div class="social-links">
						<div class="social-icons-group">
							<a href="https://github.com/Baalgarthem" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
