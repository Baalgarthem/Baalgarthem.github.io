---
import Layout from '../../layouts/Layout.astro';
import softwareData from '../../data/software.json';
---

<Layout title="Módulo Software - Ing. Arturo Ramirez">
	<section class="software container">
		<h1 class="page-title">Módulo Software</h1>
		<p class="subtitle">Explora mis proyectos de desarrollo, repositorios y presentaciones.</p>

		<div class="projects-grid">
			{softwareData.map((project) => (
				<article class="project-card">
					<div class="project-image">
						{project.image ? (
							<img src={project.image} alt={`Imagen de ${project.title}`} />
						) : (
							<div class="placeholder-img"><span>Sin Imagen</span></div>
						)}
					</div>
					<div class="project-info">
						<h3>{project.title}</h3>
						<p>{project.description}</p>
						<div class="project-links">
							{project.youtube && (
								<a href={project.youtube} target="_blank" rel="noopener noreferrer" class="link-btn youtube">
									▶ YouTube
								</a>
							)}
							{project.github && (
								<a href={project.github} target="_blank" rel="noopener noreferrer" class="link-btn github">
									⌨ GitHub
								</a>
							)}
						</div>
					</div>
				</article>
			))}
			
			{softwareData.length === 0 && (
				<p class="empty-state">Aún no hay proyectos añadidos. Utiliza el generador para agregar uno nuevo.</p>
			)}
		</div>
	</section>
</Layout>

<style>
	.software {
		padding: 2rem 20px;
	}

	.page-title {
		text-align: center;
		color: var(--primary-color);
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		text-align: center;
		color: #666;
		font-size: 1.1rem;
		margin-bottom: 3rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: 2rem;
	}

	.project-card {
		background: #fff;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
		transition: transform 0.3s;
		display: flex;
		flex-direction: column;
	}

	.project-card:hover {
		transform: translateY(-5px);
	}

	.project-image img {
		width: 100%;
		height: 220px;
		object-fit: cover;
		display: block;
	}

	.placeholder-img {
		height: 220px;
		background-color: #ecf0f1;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #95a5a6;
		font-weight: bold;
	}

	.project-info {
		padding: 1.5rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.project-info h3 {
		color: var(--secondary-color);
		margin-bottom: 1rem;
		font-size: 1.4rem;
	}

	.project-info p {
		color: #555;
		font-size: 1rem;
		margin-bottom: 1.5rem;
		flex: 1;
	}

	.project-links {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.link-btn {
		display: inline-block;
		padding: 0.5rem 1rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: bold;
		font-size: 0.9rem;
		transition: opacity 0.3s;
	}

	.link-btn:hover {
		opacity: 0.8;
	}

	.youtube {
		background-color: #ff0000;
		color: white;
	}

	.github {
		background-color: #333;
		color: white;
	}
	
	.empty-state {
		grid-column: 1 / -1;
		text-align: center;
		padding: 3rem;
		background: #fff;
		border-radius: 8px;
		color: #777;
		font-style: italic;
	}
</style>
